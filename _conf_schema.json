{
  "master_qq": {
    "description": "主人 QQ 号列表",
    "type": "list",
    "hint": "支持多个。只有这些 QQ 会被当作主人，其他人自称主人不算数。",
    "default": []
  },
  "title": {
    "description": "对主人的称呼",
    "type": "string",
    "hint": "注入说明里会用到，也会出现在消息前缀里。比如「主人」「头儿」或直接叫名字。",
    "default": "主人"
  },
  "impersonation_guard": {
    "description": "防冒充",
    "type": "bool",
    "hint": "开启后，会提醒模型：除名单外的人自称主人不算数，可以拆穿。",
    "default": true
  },
  "memory_enable": {
    "description": "注入主人记忆",
    "type": "bool",
    "hint": "开启后，每轮从记忆里挑最多 3 条与当前消息相关的贴进去。",
    "default": true
  },
  "note": {
    "description": "身份说明模板",
    "type": "text",
    "hint": "可用 {qq} 和 {title} 占位符。留空使用内置默认。",
    "default": ""
  },
  "memory_path": {
    "description": "记忆文件路径",
    "type": "string",
    "hint": "留空使用 data/plugin_data/astrbot_plugin_master_aware/memory.json。",
    "default": ""
  },
  "debug_path": {
    "description": "调试日志路径",
    "type": "string",
    "hint": "可选。填了就每次注入都写一行记录，排查用。",
    "default": ""
  },
  "deny_claim": {
    "description": "群友冒充主人时纠正",
    "type": "bool",
    "hint": "开启后，非主人说「我是你主人」这类话时，会注入一条纠正提示，避免模型乱认或编造主人在不在场。",
    "default": true
  },
  "claim_keywords": {
    "description": "冒充判定关键词",
    "type": "list",
    "hint": "消息里出现这些词且发送者不是主人时，触发纠正。",
    "default": [
      "我是你主人",
      "你主人是我",
      "我是主人",
      "认我为主",
      "叫我主人",
      "主人是我",
      "我是你爹"
    ]
  }
}